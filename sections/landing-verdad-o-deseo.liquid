her.position.set(-.8, 0, 0); her.rotation.y = Math.PI / 2; scene.add(her);
/* Él: echado hacia atrás en la silla, leyendo una carta */
const him = person({ female: false, skin: '#a8664c', top: '#d9d2c8', bottom: '#27305e', shoe: '#3a2420', hair: '#2b1b20',
  lean: -.2,
  armL: { el: [-.2, .64, .02], wr: [-.13, .575, .22], n: [0, 1, 0] },                      // mano sobre el muslo
  armR: { el: [.2, .72, .06], wr: [.09, .98, .24], f: [-.15, .95, .1], n: [.25, 0, 1],     // mano en alto con la carta
    card: g => later.push(() => {
      const c = cardMesh(); c.scale.setScalar(1.3);
      c.position.set(.08, 1.06, .25);
      c.rotation.set(Math.PI / 2 - .25, 1.05, 0, 'YXZ');
      g.add(c);
    }) } });
him.position.set(.9, 0, 0); him.rotation.y = -Math.PI / 2; scene.add(him);

/* ================= Objetos sobre la mesa ================= */
const glassMat = new THREE.MeshStandardMaterial({ color: '#f3f0ff', flatShading: true, roughness: .15, transparent: true, opacity: .32, depthWrite: false });
const wineMat = M('#a3123a', { roughness: .3 });
function wineGlass(x, z, fill) {
  const g = new THREE.Group(); g.position.set(x, TOP, z); scene.add(g);
  const pts = [[0, 0], [.036, 0], [.036, .006], [.007, .014], [.006, .085], [.032, .098], [.044, .135], [.042, .175], [.037, .195]].map(([r, y]) => new THREE.Vector2(r, y));
  const glass = new THREE.Mesh(new THREE.LatheGeometry(pts, 9), glassMat); glass.castShadow = true; g.add(glass);
  const h = .1 + fill * .06;
  const w = [[0, .1], [.03, .1], [.042, .13], [.0435, h], [0, h]].map(([r, y]) => new THREE.Vector2(r * .96, y));
  mesh(new THREE.LatheGeometry(w, 9), wineMat, g);
  return g;
}
wineGlass(-.29, .0, .7);
const g2 = wineGlass(.3, .17, .45);
mesh(new THREE.BoxGeometry(.016, .012, .004), M('#e0235a'), g2, [.0, .193, .037]); // marca de labial

// Cenicero + cigarrillo
const ash = new THREE.Group(); ash.position.set(.06, TOP, -.3); scene.add(ash);
mesh(facet(new THREE.CylinderGeometry(.085, .075, .032, 8), .004), M('#f2b234', { roughness: .4 }), ash, [0, .016, 0]);
mesh(new THREE.CylinderGeometry(.063, .055, .02, 8), M('#5b3a2a'), ash, [0, .024, 0]);
const cig = new THREE.Group(); cig.position.set(-.07, .036, .01); cig.rotation.set(0, -.5, -.12); ash.add(cig);
mesh(new THREE.CylinderGeometry(.0065, .0065, .068, 6), M('#fbf8f2'), cig, [.04, 0, 0], null, [0, 0, Math.PI / 2]);
