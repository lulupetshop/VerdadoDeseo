<script>
{% raw %}
/* ================= CONFIG =================
   Cambios frecuentes en una sola línea. Precios en pesos.
   Si Shopify tiene el producto publicado, el precio, el tachado y el stock se toman de la tienda (VOD_LIVE). */
var CONFIG = {
  minutos: VOD_SETTINGS.minutos || 15,                 // duración del contador por visitante
  codigo: VOD_SETTINGS.codigo || 'NOCHE50',            // código de Shopify que aplica la oferta (solo al PDF)
  descuento: VOD_SETTINGS.descuento || 50,             // % del código, para mostrar el precio con oferta
  pdf:  { handle: 'verdad-o-deseo-pdf', variant: 51562139255001, precio: 37500 },
  mazo: { handle: 'verdad-o-deseo-mazo-fisico-reserva', variant: 51565634191577, precio: 48990, tachado: 72990, stock: 50, total: 50 },
  extras: [
    { handle: 'otra-posicion',       variant: 51562139484377, nombre: 'Otra Posición',       linea: 'Una guía para explorar en pareja',            precio: 11990, tachado: 24990, img: 'otra-posicion' },
    { handle: 'esta-noche-se-juega', variant: 51562139549913, nombre: 'Esta Noche Se Juega', linea: '100 juegos para romper la rutina',            precio: 7990,  tachado: 17300, img: 'esta-noche-se-juega' },
    { handle: 'sin-filtro',          variant: 51562140270809, nombre: 'Sin Filtro',          linea: '300 preguntas para conocerse cada vez más',   precio: 5390,  tachado: 11990, img: 'sin-filtro' },
    { handle: 'me-debes-una',        variant: 51562140303577, nombre: 'Me Debés Una',        linea: 'Cupones para canjear cuando ustedes quieran', precio: 2990,  tachado: 5990,  img: 'me-debes-una' }
  ]
};

(function () {
  /* Datos reales de Shopify por encima de los de respaldo */
  function live(p) {
    var l = (window.VOD_LIVE || {})[p.handle];
    if (!l) return;
    p.variant = l.variant; p.precio = l.precio;
    if (l.tachado) p.tachado = l.tachado;
    if (typeof l.stock === 'number') p.stock = l.stock;
  }
  live(CONFIG.pdf); live(CONFIG.mazo); CONFIG.extras.forEach(live);

  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var fmt = function (n) { return '$' + Math.round(n).toLocaleString('es-AR'); };
  var oferta = Math.round(CONFIG.pdf.precio * (1 - CONFIG.descuento / 100));

  /* ---------- Gate +18 ---------- */
  var gate = $('#gate');
  try { if (sessionStorage.getItem('vod-18') === '1') gate.hidden = true; } catch (e) {}
  $('#gate-yes').addEventListener('click', function () {
    try { sessionStorage.setItem('vod-18', '1'); } catch (e) {}
    gate.hidden = true;
  });

