  var bar = $('#bar'), buybar = $('#buybar'), hero = $('#hero');
  function onScroll() {
    bar.classList.toggle('pill', window.scrollY > 60);
    buybar.classList.toggle('on', window.scrollY > hero.offsetHeight * .7);
  }
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  /* ---------- Contador: 15 minutos por visitante; al llegar a cero vuelve el precio normal ---------- */
  var KEY = 'vod-oferta-fin', fin;
  try { fin = parseInt(localStorage.getItem(KEY), 10); } catch (e) {}
  if (!fin) { fin = Date.now() + CONFIG.minutos * 60000; try { localStorage.setItem(KEY, String(fin)); } catch (e) {} }
  function activa() { return Date.now() < fin; }
  $$('[data-label]').forEach(function (el) { el.dataset.orig = el.textContent; });

  function pintarPrecios() {
    var on = activa();
    $$('[data-offer]').forEach(function (el) { el.classList.toggle('expired', !on); });
    $$('[data-label]').forEach(function (el) { el.textContent = on ? el.dataset.orig : 'La oferta terminó'; });
    $$('[data-was]').forEach(function (el) { el.textContent = fmt(CONFIG.pdf.precio); });
    $$('[data-now]').forEach(function (el) { el.textContent = fmt(on ? oferta : CONFIG.pdf.precio); });
    $$('[data-off]').forEach(function (el) { el.textContent = CONFIG.descuento + ' % off'; });
    if (!on) $$('[data-timer]').forEach(function (el) { el.textContent = ''; });
  }
  function pintarUpsell() {
    var dif = M.precio - CONFIG.pdf.precio, on = activa();
    $$('[data-upsell]').forEach(function (el) {
      el.textContent = !on && hayMazo && dif > 0 ? 'Por ' + fmt(dif) + ' más tenés el mazo impreso, con envío gratis y el PDF de regalo.' : '';
    });
  }
  var estaba = activa();
  function tick() {
    var r = Math.max(0, fin - Date.now()), m = Math.floor(r / 60000), s = Math.floor(r / 1000) % 60;
    var txt = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    if (activa()) $$('[data-timer]').forEach(function (el) { el.textContent = txt; });
    if (estaba !== activa()) { estaba = activa(); pintarPrecios(); pintarUpsell(); resumen(); }
  }

  /* ---------- Mazo físico: precio y stock real. Al llegar a 0 se deja de vender ---------- */
  var M = CONFIG.mazo, hayMazo = M.stock > 0;
  $$('[data-mazo-was]').forEach(function (el) { el.textContent = M.tachado ? fmt(M.tachado) : ''; });
  $$('[data-mazo-now]').forEach(function (el) { el.textContent = fmt(M.precio); });
  $$('[data-mazo-off]').forEach(function (el) { el.textContent = M.tachado ? Math.round((1 - M.precio / M.tachado) * 100) + ' % off' : ''; });
  $$('[data-stock]').forEach(function (el) { el.textContent = hayMazo ? 'Quedan ' + M.stock + ' de ' + M.total : 'Agotado'; });
  if (!hayMazo) $$('[data-buy="mazo"]').forEach(function (b) { b.textContent = 'Agotado'; b.setAttribute('aria-disabled', 'true'); b.disabled = true; });

  pintarPrecios(); pintarUpsell(); tick(); setInterval(tick, 1000);

  /* ---------- Ventana de complementos: base = mazo (con el PDF de regalo) o PDF ---------- */
  var modal = $('#addons'), lista = $('#addon-list'), elegidos = {}, ultimoFoco = null, base = 'mazo';
  CONFIG.extras.forEach(function (x) {
    var li = document.createElement('li');
    li.className = 'addon';
    li.innerHTML =
      '<img src="' + (window.VOD_IMG || {})[x.img] + '" alt="" width="56" height="84" loading="lazy">' +
      '<div><h3></h3><p></p><div class="p"><span class="was"></span><b></b></div></div>' +
      '<button class="toggle" type="button" aria-pressed="false">Agregar</button>';
    $('h3', li).textContent = x.nombre;
    $('p', li).textContent = x.linea;
    $('.was', li).textContent = x.tachado ? fmt(x.tachado) : '';
    $('b', li).textContent = fmt(x.precio);
    var t = $('.toggle', li);
    t.setAttribute('aria-label', 'Agregar ' + x.nombre);
    t.addEventListener('click', function () {
      var on = !elegidos[x.variant];
      if (on) elegidos[x.variant] = x; else delete elegidos[x.variant];
      t.setAttribute('aria-pressed', on ? 'true' : 'false');
      t.textContent = on ? 'Agregado' : 'Agregar';
      li.classList.toggle('sel', on);
      resumen();
    });
    lista.appendChild(li);
  });

  /* Mazo: el carrito lleva el mazo y el PDF; el descuento automático de Shopify deja el PDF en $0 */
  function link(conExtras) {
    var items = base === 'mazo' ? [M.variant + ':1', CONFIG.pdf.variant + ':1'] : [CONFIG.pdf.variant + ':1'];
    if (conExtras) Object.keys(elegidos).forEach(function (v) { items.push(v + ':1'); });
    return '/cart/' + items.join(',') + (base === 'pdf' && activa() ? '?discount=' + encodeURIComponent(CONFIG.codigo) : '');
  }
  function resumen() {
    var filas = '', total;
    if (base === 'mazo') {
      total = M.precio;
      filas += '<div><span>Mazo físico · Preventa</span><span>' + fmt(M.precio) + '</span></div>';
      filas += '<div><span>PDF de regalo</span><span>Gratis</span></div>';
    } else {
      total = activa() ? oferta : CONFIG.pdf.precio;
      filas += '<div><span>Verdad o Deseo · PDF</span><span>' + fmt(total) + '</span></div>';
    }
    var fijas = base === 'mazo' ? 2 : 1;
    Object.keys(elegidos).forEach(function (v) {
      var x = elegidos[v]; total += x.precio;
      filas += '<div><span></span><span>' + fmt(x.precio) + '</span></div>';
    });
    filas += '<div class="total"><span>Total</span><span>' + fmt(total) + '</span></div>';
    var r = $('#resumen'); r.innerHTML = filas;
    var nombres = Object.keys(elegidos).map(function (v) { return elegidos[v].nombre; });
    $$('div', r).slice(fijas, fijas + nombres.length).forEach(function (d, i) { d.firstChild.textContent = nombres[i]; });
    $('#pay').href = link(true);
  }
  function abrir(e) {
    if (e) e.preventDefault();
    base = e && e.currentTarget.dataset.buy === 'pdf' || !hayMazo ? 'pdf' : 'mazo';
    $('#addons-timer').hidden = base === 'mazo';
    ultimoFoco = document.activeElement;
    resumen();
    modal.hidden = false; document.body.classList.add('modal-open');
    requestAnimationFrame(function () { modal.classList.add('on'); });
    $('.toggle', modal).focus({ preventScroll: true });
  }
  function cerrar() {
    modal.classList.remove('on'); document.body.classList.remove('modal-open');
    setTimeout(function () { modal.hidden = true; }, 250);
    if (ultimoFoco) ultimoFoco.focus({ preventScroll: true });
  }
  $$('[data-buy]').forEach(function (b) { b.addEventListener('click', abrir); });
  $('[data-close]').addEventListener('click', cerrar);
  modal.addEventListener('click', function (e) { if (e.target === modal) cerrar(); });
  addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) cerrar(); });
  $('#skip').addEventListener('click', function () { location.href = link(false); });
})();
{% endraw %}
</script>

