/* ================= Utilidades low-poly ================= */
const mats = {};
function M(color, o = {}) {
  const k = color + JSON.stringify(o);
  return mats[k] || (mats[k] = new THREE.MeshStandardMaterial({ color, flatShading: true, roughness: .78, metalness: 0, ...o }));
}
function hash(x, y, z) { const n = Math.sin(x * 12.9898 + y * 78.233 + z * 37.719) * 43758.5453; return n - Math.floor(n); }
/* Desplaza vértices de forma estable (mismo punto, mismo desplazamiento) para marcar facetas sin abrir grietas */
function facet(geo, amt) {
  const p = geo.attributes.position;
  for (let i = 0; i < p.count; i++) {
    const x = p.getX(i), y = p.getY(i), z = p.getZ(i);
    const a = Math.round(x * 1e4), b = Math.round(y * 1e4), c = Math.round(z * 1e4);
    p.setXYZ(i, x + (hash(a, b, c) - .5) * amt, y + (hash(b, c, a) - .5) * amt, z + (hash(c, a, b) - .5) * amt);
  }
  geo.computeVertexNormals();
  return geo;
}
function mesh(geo, mat, parent, pos, scl, rot) {
  const m = new THREE.Mesh(geo, mat);
  m.castShadow = true; m.receiveShadow = true;
  if (pos) m.position.set(...pos);
  if (scl) m.scale.set(...scl);
  if (rot) m.rotation.set(...rot);
  parent && parent.add(m);
  return m;
}
const UP = new THREE.Vector3(0, 1, 0);
/* Segmento cónico entre dos puntos (brazos, piernas, cuello) */
function limb(parent, a, b, r1, r2, mat, seg = 6) {
  const A = new THREE.Vector3(...a), B = new THREE.Vector3(...b);
  const d = B.clone().sub(A), len = d.length();
  const g = facet(new THREE.CylinderGeometry(r2, r1, len, seg, 2), Math.min(r1, r2) * .25);
  const m = mesh(g, mat, parent);
  m.position.copy(A).addScaledVector(d, .5);
  m.quaternion.setFromUnitVectors(UP, d.normalize());
  mesh(new THREE.IcosahedronGeometry(r1 * 1.02, 1), mat, parent, a);
  return m;
}
function blob(parent, r, mat, pos, scl, amt = .1, detail = 1) {
  return mesh(facet(new THREE.IcosahedronGeometry(r, detail), r * amt), mat, parent, pos, scl);
}

/* ================= Escenario ================= */
const floor = new THREE.Mesh(new THREE.CircleGeometry(14, 48), new THREE.MeshStandardMaterial({ color: '#2a1620', roughness: 1 }));
floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; scene.add(floor);
/* Alfombra redonda bajo la mesa */
mesh(new THREE.CylinderGeometry(1.3, 1.3, .012, 18), M('#5a1428'), scene, [0, .006, 0]);

const TOP = 0.7425;           // altura de la tapa de la mesa
const wood = M('#9a4524'), woodDark = M('#5a2414');
const table = new THREE.Group(); scene.add(table);
mesh(facet(new THREE.CylinderGeometry(.56, .56, .045, 14, 1), .012), wood, table, [0, .72, 0]);
mesh(new THREE.CylinderGeometry(.53, .5, .05, 14, 1), woodDark, table, [0, .69, 0]);
mesh(new THREE.CylinderGeometry(.045, .06, .66, 6), woodDark, table, [0, .36, 0]);
mesh(facet(new THREE.CylinderGeometry(.1, .3, .05, 8), .01), woodDark, table, [0, .025, 0]);

function chair(x, rotY) {
  const g = new THREE.Group(); g.position.set(x, 0, 0); g.rotation.y = rotY; scene.add(g);
  const c = M('#4a1f2c');
  mesh(new THREE.BoxGeometry(.44, .05, .42), c, g, [0, .44, 0]);
  for (const [lx, lz] of [[-.18, -.17], [.18, -.17], [-.18, .17], [.18, .17]]) mesh(new THREE.CylinderGeometry(.018, .016, .44, 5), c, g, [lx, .22, lz]);
  for (const lx of [-.18, .18]) mesh(new THREE.CylinderGeometry(.018, .018, .5, 5), c, g, [lx, .7, -.19]);
  mesh(new THREE.BoxGeometry(.44, .14, .035), c, g, [0, .9, -.19]);
  return g;
}

/* ================= Personas ================= */
const later = [];   // cosas que necesitan las cartas, que se definen más abajo
/* Segmento cónico sin articulación */
function seg(parent, a, b, r1, r2, mat, n = 7) {
  const A = new THREE.Vector3(...a), B = new THREE.Vector3(...b), d = B.clone().sub(A), len = d.length();
  const m = mesh(facet(new THREE.CylinderGeometry(r2, r1, len, n, 1), Math.min(r1, r2) * .18), mat, parent);
  m.position.copy(A).addScaledVector(d, .5);
  m.quaternion.setFromUnitVectors(UP, d.normalize());
  return m;
}
const lerp3 = (a, b, t) => a.map((v, i) => v + (b[i] - v) * t);
/* Mano: palma + dedos juntos + pulgar. f = hacia dónde apunta, n = dorso de la mano */
function hand(parent, at, f, n, skinMat, size, thumbSide = 1) {
  const F = new THREE.Vector3(...f).normalize(), N = new THREE.Vector3(...n).normalize();
  const R = new THREE.Vector3().crossVectors(N, F).normalize(); N.crossVectors(F, R).normalize();
  const h = new THREE.Group(); h.position.set(...at);
  h.quaternion.setFromRotationMatrix(new THREE.Matrix4().makeBasis(R, N, F)); parent.add(h);
  const k = size;
  mesh(facet(new THREE.BoxGeometry(.05 * k, .018 * k, .055 * k, 2, 1, 2), .004 * k), skinMat, h, [0, 0, .026 * k]);
  const fing = mesh(facet(new THREE.BoxGeometry(.046 * k, .014 * k, .048 * k, 3, 1, 2), .004 * k), skinMat, h, [0, -.003 * k, .075 * k]);
  fing.rotation.x = .18;
  const th = mesh(facet(new THREE.BoxGeometry(.015 * k, .014 * k, .042 * k, 1, 1, 2), .003 * k), skinMat, h, [thumbSide * .03 * k, -.004 * k, .03 * k]);
  th.rotation.y = thumbSide * .55;
  return h;
}
/* Brazo con hombro, bíceps, codo, antebrazo y muñeca */
function arm(parent, sh, el, wr, o) {
  const rU = o.r, rE = o.r * .74, rW = o.r * .52;
  blob(parent, rU * 1.08, o.sleeve, sh, [1, .85, 1], .06, 2);                    // hombro
  seg(parent, sh, el, rU, rE * 1.05, o.short ? o.skin : o.sleeve, 11);
  blob(parent, rE * 1.06, o.short ? o.skin : o.sleeve, el, [1, 1, 1], .05, 2);   // codo
  if (o.cuff) seg(parent, el, lerp3(el, wr, .16), rE * 1.2, rE * 1.12, o.sleeve, 11);
  seg(parent, el, wr, rE * 1.02, rW, o.skin, 11);
  blob(parent, rW * 1.05, o.skin, wr, [1.15, .85, 1], .05, 1);                   // muñeca
}


function person(o) {
  const g = new THREE.Group();
  const skin = M(o.skin), top = M(o.top), bottom = M(o.bottom), shoe = M(o.shoe, { roughness: .5 }), hair = M(o.hair, { roughness: .6 });
  // cadera y piernas (sentado, mirando a +z)
  blob(g, .1, bottom, [0, .53, -.02], [1.65, .85, 1.45], .12, 2);
  for (const s of [-1, 1]) {
    limb(g, [s * .085, .53, 0], [s * .09, .52, .4], .075, .06, bottom, 11);
    limb(g, [s * .09, .51, .4], [s * .095, .08, .44], .052, .036, o.female ? skin : bottom, 9);
    if (o.female) {
      mesh(new THREE.BoxGeometry(.06, .05, .16), shoe, g, [s * .095, .045, .48]);
      mesh(new THREE.CylinderGeometry(.008, .006, .07, 4), shoe, g, [s * .095, .035, .41]);
    } else {
      mesh(facet(new THREE.BoxGeometry(.075, .05, .17, 2, 1, 2), .008), shoe, g, [s * .095, .025, .48]);
    }
  }
  // torso inclinado hacia la mesa
  const T = new THREE.Group(); T.position.set(0, .55, -.03); T.rotation.x = o.lean; g.add(T);
  const prof = (o.female
    ? [[0, 0], [.125, 0], [.14, .06], [.112, .17], [.13, .27], [.145, .33], [.135, .39], [.085, .43], [0, .44]]
    : [[0, 0], [.14, 0], [.15, .08], [.15, .2], [.172, .3], [.19, .37], [.16, .42], [.08, .45], [0, .46]]
  ).map(([r, y]) => new THREE.Vector2(r, y));
  mesh(facet(new THREE.LatheGeometry(prof, 14), .012), top, T, [0, 0, 0], [1, 1, .64]);
  if (o.female) {
    for (const s of [-1, 1]) blob(T, .052, top, [s * .058, .3, .07], [1, .95, .9], .08, 1);
    mesh(facet(new THREE.CylinderGeometry(.09, .12, .1, 8), .01), skin, T, [0, .405, 0], [1, 1, .62]); // escote
  }
  limb(T, [0, .42, 0], [0, .51, .015], .045, .04, skin, 9);
  blob(T, .1, skin, [0, .61, .025], [.86, 1.12, .98], .07, 2);
  // pelo
  if (o.female) {
    blob(T, .108, hair, [0, .645, -.012], [.98, 1.0, 1.0], .1, 2);
    blob(T, .1, hair, [0, .58, -.03], [1.02, .95, .9], .14, 2);
    blob(T, .05, hair, [.045, .67, .07], [1.1, .7, 1], .2, 1);          // flequillo de costado
    blob(T, .045, hair, [-.07, .6, .05], [.6, 1.3, .8], .2, 1);
  } else {
    blob(T, .104, hair, [0, .655, -.01], [.95, .8, 1.02], .1, 2);
  }
  // brazos: cada pose define codo, muñeca y cómo queda la mano
  const ct = Math.cos(o.lean), st = Math.sin(o.lean);
  const toG = (x, y, z) => [x, .55 + y * ct - z * st, -.03 + y * st + z * ct];
  const sw = o.female ? .14 : .175;
  for (const s of [-1, 1]) {
    const P = s < 0 ? o.armL : o.armR;
    const sh = toG(s * sw, .375, 0);
    arm(g, sh, P.el, P.wr, { r: o.female ? .036 : .046, sleeve: o.female ? skin : top, skin, short: o.female, cuff: !o.female });
    const f = P.f || new THREE.Vector3(...P.wr).sub(new THREE.Vector3(...P.el)).setY(0).toArray();
    const fv = new THREE.Vector3(...f).normalize().multiplyScalar(o.female ? .012 : .016);
    hand(g, [P.wr[0] + fv.x, P.wr[1] + fv.y, P.wr[2] + fv.z], f, P.n || [0, 1, 0], skin, o.female ? .82 : 1, -s);
    if (P.card) P.card(g);
  }
  return g;
}

chair(-.82, Math.PI / 2);
chair(.92, -Math.PI / 2);
const her = person({ female: true, skin: '#c9897a', top: '#e6b49c', bottom: '#d7a38b', shoe: '#c9183c', hair: '#3d2244',
  lean: .26,
  armL: { el: [-.16, TOP + .028, .22], wr: [-.12, TOP + .022, .46] },
