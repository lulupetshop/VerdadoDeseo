<script>
  document.querySelectorAll('.dc-faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.dc-faq-item');
      var answer = item.querySelector('.dc-faq-a');
      var isOpen = item.getAttribute('data-open') === 'true';
      document.querySelectorAll('.dc-faq-item').forEach(function(i){
        i.setAttribute('data-open','false');
        i.querySelector('.dc-faq-a').style.maxHeight = null;
      });
      if(!isOpen){
        item.setAttribute('data-open','true');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }
    });
  });

  document.querySelectorAll('.js-buy').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      fetch('/cart/clear.js', { method: 'POST' })
        .then(function(){
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: 50583280025817, quantity: 1 }] })
          });
        })
        .then(function(){ window.location.href = '/checkout'; })
        .catch(function(){ window.location.href = btn.href; });
    });
  });

  if ('IntersectionObserver' in window) {
    var dcObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) {
          entry.target.classList.add('dc-in');
          dcObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.dc-reveal').forEach(function(el){ dcObserver.observe(el); });
  } else {
    document.querySelectorAll('.dc-reveal').forEach(function(el){ el.classList.add('dc-in'); });
  }
</script>

