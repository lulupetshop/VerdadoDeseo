<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  .dc-page{
    --indigo-950:#1e1b4b;
    --purple-900:#581c87;
    --purple-950:#3b0764;
    --purple-800:#6b21a8;
    --amber-400:#fbbf24;
    --amber-100:#fef3c7;
    --orange-500:#f97316;
    --slate-900:#0f172a;
    --slate-50:#f8fafc;
    --slate-200:#e2e8f0;
    --slate-300:#cbd5e1;
    --slate-400:#94a3b8;
    --green-400:#4ade80;
    --indigo-900:#312e81;
    --indigo-100:#e0e7ff;
    --white:#ffffff;
    background:#fff;color:var(--slate-900);
    font-family:'Poppins',Arial,sans-serif;
    -webkit-font-smoothing:antialiased;overflow-x:hidden;
  }
  .dc-page *{box-sizing:border-box;}
  .dc-page img,.dc-page svg{max-width:100%;display:block;}
  .dc-page h1,.dc-page h2,.dc-page h3{
    font-family:'Outfit',sans-serif;margin:0;text-wrap:balance;font-weight:800;
  }
  .dc-page p{margin:0;}
  .dc-page a{color:inherit;text-decoration:none;}
  .dc-page button{font-family:inherit;cursor:pointer;border:none;background:none;}
  .dc-page ul{margin:0;padding:0;list-style:none;}

  .dc-wrap{max-width:1120px;margin:0 auto;padding-left:20px;padding-right:20px;}
  .dc-section{padding:38px 0;}
  @media (min-width:750px){.dc-section{padding:52px 0;}}
  .dc-section-dark{background:var(--slate-900);color:#fff;}
  .dc-section-light{background:var(--slate-50);}
  .dc-head{max-width:640px;margin:0 auto 22px;text-align:center;}
  .dc-head h2{font-size:32px;line-height:1.2;text-align:center;}
  .dc-head p{margin-top:12px;font-size:16px;line-height:1.6;color:var(--slate-400);text-align:center !important;}
  .dc-section:not(.dc-section-dark) .dc-head p{color:#556;}

  .ph{
    background:#e4e7ed;border:1.5px dashed #a9b1bf;color:#5c6472;
    display:flex;align-items:center;justify-content:center;text-align:center;
    font-size:11.5px;font-weight:700;line-height:1.4;padding:10px;
  }
  .ph.ph-img{background:none;border:none;padding:0;overflow:hidden;}
  .ph.ph-img img{width:100%;height:100%;object-fit:cover;display:block;}

  .dc-btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    padding:16px 28px;border-radius:14px;
    font-family:'Outfit',sans-serif;font-size:15px;font-weight:800;
    background:linear-gradient(90deg,var(--amber-400),var(--orange-500));
    color:var(--indigo-950) !important;
    box-shadow:0 10px 24px -8px rgba(249,115,22,.45);
    transition:transform .2s ease,box-shadow .2s ease;
    animation:dcPulse 2s ease-in-out infinite;
  }
  .dc-btn:hover{transform:scale(1.05);box-shadow:0 16px 30px -8px rgba(249,115,22,.55);animation-play-state:paused;}
  .dc-btn:active{transform:scale(.95);}

  @keyframes dcFadeUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
  @keyframes dcFadeDown{from{opacity:0;transform:translateY(-20px);}to{opacity:1;transform:translateY(0);}}
  @keyframes dcFloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-15px);}}
  @keyframes dcPulse{0%,100%{transform:scale(1);}50%{transform:scale(1.03);}}
  @media (prefers-reduced-motion:reduce){
    .dc-btn{animation:none;}
    .dc-hero-visual img{animation:none;}
    .dc-hero-badge,.dc-hero h1,.dc-hero-sub,.dc-hero-audience,.dc-hero-chips,.dc-hero-visual,.dc-hero-cta,.dc-reveal{animation:none !important;opacity:1 !important;transform:none !important;}
  }

  /* ============ HERO ============ */
  .dc-hero{
    padding:40px 0 34px;color:#fff;text-align:center;
    background:linear-gradient(160deg,var(--indigo-950) 0%,var(--purple-900) 55%,var(--purple-950) 100%);
  }
  @media (min-width:750px){.dc-hero{padding:56px 0 46px;}}
  .dc-hero .dc-wrap{display:flex;flex-direction:column;align-items:center;}
  .dc-hero-badge{
    display:inline-flex;align-items:center;gap:6px;padding:7px 16px;margin-bottom:18px;
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:999px;
    font-size:12.5px;font-weight:700;color:var(--amber-400);
    animation:dcFadeDown .6s ease-out both;
  }
  .dc-hero h1{font-size:clamp(28px,5vw,44px);line-height:1.15;max-width:820px;width:100%;text-align:center !important;animation:dcFadeUp .6s .1s ease-out both;}
  .dc-hero-sub{max-width:600px;width:100%;margin-top:18px;font-size:16px;line-height:1.6;color:var(--slate-300);text-align:center !important;animation:dcFadeUp .6s .2s ease-out both;}
  .dc-hero-audience{max-width:560px;width:100%;margin-top:12px;font-size:13.5px;line-height:1.6;color:var(--slate-400);text-align:center !important;animation:dcFadeUp .6s .3s ease-out both;}
  .dc-hero-chips{
    display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:640px;width:100%;margin-top:26px;text-align:left;
    animation:dcFadeUp .6s .4s ease-out both;
  }
  .dc-hero-chip{
    display:flex;align-items:center;gap:9px;padding:11px 12px;
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.10);border-radius:12px;
    font-size:12.5px;font-weight:600;color:#fff;
  }
  .dc-hero-chip svg{width:17px;height:17px;color:var(--amber-400);flex:none;}
  .dc-hero-visual{margin-top:26px;max-width:560px;width:100%;animation:dcFadeUp .6s .5s ease-out both;}
  .dc-hero-visual .ph{aspect-ratio:16/10;border-radius:20px;}
  .dc-hero-visual img{animation:dcFloat 4s ease-in-out infinite;}
  .dc-hero-cta{margin-top:24px;display:flex;flex-direction:column;align-items:center;animation:dcFadeUp .6s .6s ease-out both;}
  .dc-hero-price{margin-top:14px;font-size:13px;color:var(--slate-400);text-align:center !important;}
  .dc-hero-price strong{color:#fff;font-size:15px;}
  .dc-hero-price del{color:var(--slate-400);opacity:.7;margin-right:4px;}

  @media (min-width:750px){
    .dc-hero-chips{max-width:720px;}
  }

  /* ============ EMPATIA ============ */
  .dc-empathy-grid{display:grid;gap:32px;align-items:center;}
  .dc-empathy-visual .ph{aspect-ratio:4/3;border-radius:18px;}
  .dc-empathy-copy ul{display:flex;flex-direction:column;gap:10px;margin-top:16px;}
  .dc-empathy-copy li{display:flex;gap:9px;align-items:center;font-size:15px;font-weight:600;color:var(--slate-900);}
  .dc-empathy-copy li svg{width:19px;height:19px;color:#4f46e5;flex:none;}
  .dc-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px;}
  .dc-tag{background:var(--indigo-100);color:#4338ca;font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px;}
  @media (min-width:750px){.dc-empathy-grid{grid-template-columns:1fr 1fr;}}

  /* ============ QUE RECIBES ============ */
  .dc-includes-grid{display:grid;gap:32px;align-items:start;}
  .dc-includes-list{display:flex;flex-direction:column;gap:12px;margin-top:18px;}
  .dc-includes-list li{display:flex;gap:10px;align-items:flex-start;font-size:15px;color:var(--slate-900);}
  .dc-includes-list li svg{width:19px;height:19px;color:var(--green-400);flex:none;margin-top:1px;}
  .dc-includes-note{margin-top:18px;padding:16px;background:var(--amber-100);border-radius:14px;font-size:13.5px;color:#7c4a03;line-height:1.6;}
  .dc-includes-gallery{display:grid;grid-template-columns:1fr 1fr;gap:12px;order:-1;}
  .dc-includes-gallery .ph{aspect-ratio:3/4;border-radius:14px;}
  .dc-includes-gallery .ph:first-child{grid-column:1/-1;aspect-ratio:16/10;}
  @media (min-width:750px){.dc-includes-grid{grid-template-columns:1fr 1fr;}.dc-includes-gallery{order:2;}}

  /* ============ MIRA POR DENTRO (marquee) ============ */
  .dc-preview-slider{overflow:hidden;margin-top:8px;}
  .dc-preview-track{display:flex;width:max-content;gap:14px;animation:dcPreviewMove 32s linear infinite;}
  .dc-preview-slider:hover .dc-preview-track{animation-play-state:paused;}
  .dc-preview-group{display:flex;flex-shrink:0;gap:14px;}
  .dc-preview-card{flex:0 0 auto;width:200px;}
  .dc-preview-card .ph{aspect-ratio:3/4;border-radius:14px;}
  @keyframes dcPreviewMove{from{transform:translateX(0);}to{transform:translateX(-50%);}}

  /* ============ PROBLEMA / SOLUCION ============ */
  .dc-problem-grid{display:grid;gap:16px;margin-top:24px;}
  .dc-problem-card{background:#fff;border:1px solid var(--slate-200);border-radius:16px;padding:22px;}
  .dc-solution-card{background:linear-gradient(135deg,var(--indigo-950),var(--purple-900));color:#fff;border-radius:16px;padding:22px;}
  .dc-problem-card h3,.dc-solution-card h3{font-size:16px;margin-bottom:12px;}
  .dc-solution-card h3{color:var(--amber-400);}
  .dc-problem-list,.dc-solution-list{display:flex;flex-direction:column;gap:9px;}
  .dc-problem-list li{display:flex;gap:8px;font-size:13.5px;color:var(--slate-900);}
  .dc-problem-list li svg{width:16px;height:16px;color:#ef4444;flex:none;margin-top:2px;}
  .dc-solution-list li{font-size:13.5px;color:var(--slate-200);line-height:1.6;}
  @media (min-width:750px){.dc-problem-grid{grid-template-columns:1fr 1fr;}}

  /* ============ BONOS ============ */
  .dc-bonus-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
  .dc-bonus-card{background:#fff;border:1px solid var(--slate-200);border-radius:16px;overflow:hidden;box-shadow:0 10px 24px -18px rgba(15,23,42,.2);}
  .dc-bonus-card .ph{aspect-ratio:4/3;}
  .dc-bonus-body{padding:14px;}
  .dc-bonus-body h3{font-size:13.5px;line-height:1.3;margin-bottom:6px;}
  .dc-bonus-body p{font-size:12px;color:var(--slate-400);line-height:1.5;}
  @media (min-width:750px){.dc-bonus-grid{grid-template-columns:repeat(3,1fr);}.dc-bonus-grid>:last-child{grid-column:2;}}
  @media (min-width:750px) and (max-width:1000px){.dc-bonus-grid{grid-template-columns:repeat(2,1fr);}.dc-bonus-grid>:last-child{grid-column:auto;}}

  /* ============ OFERTA UNICA ============ */
  .dc-offer{
    max-width:520px;margin:0 auto;text-align:center;padding:36px 26px;border-radius:24px;color:#fff;
    background:linear-gradient(160deg,var(--indigo-950),var(--purple-900) 60%,var(--purple-950));
    box-shadow:0 30px 60px -20px rgba(59,7,100,.4);
  }
  .dc-offer-badge{display:inline-block;background:var(--amber-400);color:var(--indigo-950);font-size:12px;font-weight:800;padding:6px 14px;border-radius:999px;margin-bottom:16px;}
  .dc-offer h3{font-size:24px;color:#fff;text-align:center !important;}
  .dc-offer-price{font-family:'Outfit';font-size:52px;font-weight:900;color:var(--amber-400);margin:16px 0 6px;text-align:center !important;}
  .dc-offer-price span{font-size:16px;color:var(--slate-300);font-weight:600;}
  .dc-offer-compare{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:16px;}
  .dc-offer-was{font-size:18px;color:var(--slate-300);text-decoration:line-through;opacity:.7;}
  .dc-offer-off{background:rgba(74,222,128,.15);color:var(--green-400);font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px;}
  .dc-offer-list{text-align:left;display:flex;flex-direction:column;gap:9px;margin:22px 0;}
  .dc-offer-list li{display:flex;gap:8px;font-size:13.5px;color:var(--slate-200);}
  .dc-offer-list li svg{width:17px;height:17px;color:var(--green-400);flex:none;margin-top:1px;}
  .dc-offer .dc-btn{width:100%;}
  .dc-offer-note{margin-top:14px;font-size:12px;color:var(--slate-400);text-align:center !important;}

  /* ============ TESTIMONIOS ============ */
  .dc-testi-grid{display:grid;gap:16px;}
  .dc-testi-card{background:#fff;border:1px solid var(--slate-200);border-radius:16px;padding:20px;}
  .dc-testi-stars{color:var(--amber-400);font-size:14px;letter-spacing:1px;margin-bottom:10px;}
  .dc-testi-quote{font-size:14px;line-height:1.6;color:var(--slate-900);}
  .dc-testi-author{display:flex;align-items:center;gap:10px;margin-top:16px;padding-top:14px;border-top:1px solid var(--slate-200);}
  .dc-testi-author .ph{width:42px;height:42px;border-radius:50%;flex:none;font-size:8px;}
  .dc-testi-name{font-size:13px;font-weight:700;}
  .dc-testi-role{font-size:11.5px;color:var(--slate-400);}
  @media (min-width:750px){.dc-testi-grid{grid-template-columns:repeat(3,1fr);}}

  /* ============ GARANTIA ============ */
  .dc-guarantee{
    max-width:640px;margin:0 auto;text-align:center;padding:36px 24px;border-radius:22px;
    background:var(--amber-100);
  }
  .dc-guarantee svg{width:52px;height:52px;color:var(--orange-500);margin:0 auto 14px;}
  .dc-guarantee h3{font-size:26px;color:#7c4a03;text-align:center !important;}
  .dc-guarantee p{margin-top:12px;font-size:14px;line-height:1.6;color:#8a5a10;text-align:center !important;}

  /* ============ COMO FUNCIONA ============ */
  .dc-steps{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:8px;}
  .dc-step{text-align:center;padding:20px 14px;background:#fff;border:1px solid var(--slate-200);border-radius:16px;}
  .dc-step p{text-align:center !important;}
  .dc-step-num{
    width:38px;height:38px;border-radius:50%;background:var(--indigo-100);color:#4338ca;
    display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-family:'Outfit';font-weight:800;
  }
  .dc-step p{font-size:13.5px;font-weight:600;color:var(--slate-900);}
  @media (min-width:750px){.dc-steps{grid-template-columns:repeat(4,1fr);}}

  /* ============ FAQ ============ */
  .dc-faq-item{border-bottom:1px solid var(--slate-200);}
  .dc-faq-item:first-child{border-top:1px solid var(--slate-200);}
  .dc-faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 6px;font-size:15px;font-weight:700;color:var(--slate-900);text-align:left;}
  .dc-faq-q svg{width:18px;height:18px;flex:none;color:var(--slate-400);transition:transform .2s ease;}
  .dc-faq-item[data-open="true"] .dc-faq-q svg{transform:rotate(45deg);}
  .dc-faq-a{max-height:0;overflow:hidden;transition:max-height .25s ease;}
  .dc-faq-a p{font-size:14px;line-height:1.6;color:var(--slate-400);padding:0 6px 18px;}

  /* ============ CTA FINAL ============ */
  .dc-cta-final{
    text-align:center;color:#fff;
    background:linear-gradient(160deg,var(--indigo-950),var(--purple-900));
  }
  .dc-cta-final h2{color:#fff;font-size:30px;max-width:520px;margin:0 auto;text-align:center !important;}
  .dc-cta-final-visual{max-width:420px;margin:26px auto;}
  .dc-cta-final-visual .ph{aspect-ratio:4/3;border-radius:18px;}

  footer.dc-footer{padding:26px 0;border-top:1px solid var(--slate-200);text-align:center;}
  footer.dc-footer p{font-size:11.5px;color:var(--slate-400);max-width:560px;margin:0 auto;line-height:1.6;text-align:center !important;}

  .dc-reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease;}
  .dc-reveal.dc-in{opacity:1;transform:translateY(0);}
  .dc-reveal.dc-in:nth-child(2){transition-delay:.08s;}
  .dc-reveal.dc-in:nth-child(3){transition-delay:.16s;}
  .dc-reveal.dc-in:nth-child(4){transition-delay:.24s;}
  .dc-reveal.dc-in:nth-child(5){transition-delay:.32s;}
  .dc-reveal.dc-in:nth-child(6){transition-delay:.4s;}
  @media (prefers-reduced-motion:reduce){.dc-reveal{opacity:1;transform:none;transition:none;}}
</style>

<div class="dc-page">

  <!-- HERO -->
  <section class="dc-hero">
    <div class="dc-wrap">
      <span class="dc-hero-badge">✨ Disney Color PRO</span>
      <h1>Para quienes aman Disney, colorear y tener actividades creativas listas en casa</h1>
      <p class="dc-hero-sub">Obtén +100 libros coloreables Disney con más de 11.700 páginas listas para imprimir, para colorear en iPad y tablets o disfrutar cuando quieras.</p>
      <p class="dc-hero-audience">Perfecto para niños, adultos, fans de Disney, familias, docentes, cuidadores o cualquier persona que disfrute pintar y crear momentos mágicos en casa.</p>

      <div class="dc-hero-chips">
